# Copy to .env and adjust for your environment.
# Docker Compose loads this file automatically.

# Frontend (SvelteKit server-only; never expose as PUBLIC_)
# Docker: http://backend:8000
# Host/pnpm: http://127.0.0.1:8000
BACKEND_URL=http://backend:8000
# Trusted reverse-proxy deployments only:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# FastAPI
APP_ENV=development
PORT=8000
FRONTEND_PORT=3000
HOST_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL (SQLAlchemy + psycopg 3)
# Docker: postgresql+psycopg://hushmap:hushmap@postgres:5432/hushmap
# Host/uv with the default published port: postgresql+psycopg://hushmap:hushmap@127.0.0.1:15432/hushmap
DATABASE_URL=postgresql+psycopg://hushmap:hushmap@postgres:5432/hushmap
POSTGRES_USER=hushmap
POSTGRES_PASSWORD=hushmap
POSTGRES_DB=hushmap
POSTGRES_PORT=15432

# AI
# embedded = Gemini in-process (default)
# remote = temporary HTTP fallback to standalone AI service
AI_MODE=embedded
AI_SERVER_ENDPOINT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SUMMARY_RATE_LIMIT_PER_MINUTE=6
SUMMARY_REQUEST_RATE_LIMIT_PER_MINUTE=120
SUMMARY_GLOBAL_RATE_LIMIT_PER_MINUTE=30

# Comma-separated device upload API keys (plain values in .env; stored as hashes in-process)
DEVICE_API_KEYS=
# Explicit local-development bypass. It is ignored unless APP_ENV=development.
ALLOW_UNAUTHENTICATED_DEVICE_UPLOADS=true
UPLOAD_RATE_LIMIT_PER_MINUTE=120
AUDIO_MAX_ACTIVE_SESSIONS_PER_DEVICE=10
AUDIO_MAX_RECENT_IDEMPOTENCY_KEYS=10000
