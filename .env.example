# Copy to .env and adjust for your environment.
# Docker Compose loads this file automatically.

# Frontend (SvelteKit server-only; never expose as PUBLIC_)
# Docker: http://backend:8000
# Host/pnpm: http://127.0.0.1:8000
BACKEND_URL=http://backend:8000

# FastAPI
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL (SQLAlchemy + psycopg 3)
# Docker: postgresql+psycopg://hushmap:hushmap@postgres:5432/hushmap
# Host/uv: postgresql+psycopg://hushmap:hushmap@127.0.0.1:5432/hushmap
DATABASE_URL=postgresql+psycopg://hushmap:hushmap@postgres:5432/hushmap
POSTGRES_USER=hushmap
POSTGRES_PASSWORD=hushmap
POSTGRES_DB=hushmap
POSTGRES_PORT=15432

# AI
# embedded = Gemini in-process (default)
# remote = temporary HTTP fallback to standalone AI service
AI_MODE=embedded
AI_SERVER_ENDPOINT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated device upload API keys (plain values in .env; stored as hashes in-process)
DEVICE_API_KEYS=
